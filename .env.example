# Copy to .env.local. `npm run db:up` fills the first block automatically.

# --- Database -------------------------------------------------------------
# Runtime connection. In production use Neon's POOLED url (…-pooler.…).
DATABASE_URL=postgres://taxkatha:password@localhost:54329/taxkatha
# Direct connection for migrations and seeding. In production use Neon's
# UNPOOLED url. Locally it is the same as DATABASE_URL.
DATABASE_URL_UNPOOLED=postgres://taxkatha:password@localhost:54329/taxkatha
TEST_DATABASE_URL=postgres://taxkatha:password@localhost:54329/taxkatha_test
# Connections per server instance (default: 5 in production, 10 in development).
# DATABASE_POOL_MAX=

# --- Auth (Better Auth) ---------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The canonical site origin. Production: https://taxkatha.com
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OAuth clients. Redirect URI for each: <BETTER_AUTH_URL>/api/auth/callback/<provider>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Comma-separated emails that become admins on first sign-in WITH GOOGLE
# (verified email only). Use `npm run grant-role` for anyone else.
ADMIN_EMAILS=

# Development only: enables /sign-in "developer login" without OAuth apps.
# Ignored (and impossible to enable) in production builds.
DEV_LOGIN=false

# --- Storage --------------------------------------------------------------
# Production only (Vercel Blob). Locally, uploads go to ./.uploads
BLOB_READ_WRITE_TOKEN=

# --- Misc -----------------------------------------------------------------
# Protects /api/cron/* (Vercel Cron sends it as a bearer token).
CRON_SECRET=
